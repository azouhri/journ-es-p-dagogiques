# ---------------------------------------------------------------------------
# Base de données Supabase — projet « journées pédagogiques »
# ---------------------------------------------------------------------------
# Région : ca-central-1 (Canada Central). Exigence de la Loi 25, §12 de la
# spec. La région n'est pas modifiable après la création du projet.
#
# Copier ce fichier vers `.env` (non versionné) et coller les deux chaînes de
# connexion telles qu'affichées dans le tableau de bord Supabase :
#   Project Settings > Database > Connection string
# Ne pas recomposer l'URL à la main : le nom d'hôte du pooler varie.

# Connexion applicative, via le pooler (port 6543, mode transaction).
#
# connection_limit : 10 pour un serveur de développement de longue durée. Le
# « 1 » que recommande la documentation Supabase vise les fonctions
# serverless, où chaque invocation est isolée. Sur `next dev`, une seule page
# lance plusieurs requêtes en parallèle : avec une limite de 1, elles font la
# queue et expirent au bout de pool_timeout.
DATABASE_URL="postgresql://postgres.uitbkhibopuuqgpjdney:[PASSWORD]@[POOLER_HOST]:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20"

# Connexion directe (port 5432). Requise par `prisma migrate`, qui pose des
# verrous consultatifs incompatibles avec pgbouncer.
DIRECT_URL="postgresql://postgres.uitbkhibopuuqgpjdney:[PASSWORD]@[POOLER_HOST]:5432/postgres"

# ---------------------------------------------------------------------------
# Supabase Auth (§12 — une poignée de comptes, sans fournisseur externe)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://uitbkhibopuuqgpjdney.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_HLlKRKdBQ2jS09rmibuNGA_ziFchx_1"
